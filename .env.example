APP_NAME="Fleet Guard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://fleet-guard.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev database is EnvKit's MySQL 9.1.0 on 3306, matching Laravel Cloud's managed MySQL engine
# (MariaDB 11.8.2 shares the port for this machine's other projects; EnvKit activates one version's
# data directory at a time). Start command, account bootstrap and the reasons are in
# docs/DEV-DATABASE.md. The password is a local-only value — put your own in .env, never commit it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleet_guard_dev
DB_USERNAME=fleetguard
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production documents disk. Leave empty for the local private disk; set it (with the AWS_* pair
# above) to move the document bytes to the private bucket. Requires `composer require
# league/flysystem-aws-s3-v3`. See docs/operations/deployment.md.
FLEET_DOCUMENTS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# The dedicated column-encryption key, separate from APP_KEY. One entry per version:
# add DB_CRYPT_KEY_V2, set DB_CRYPT_KEY_VERSION=v2, run `php artisan keys:reencrypt`, then
# retire v1 only after the report says nothing is left on it. Escrow every key off-box.
DB_CRYPT_KEY_VERSION=v1
DB_CRYPT_KEY=
DB_CRYPT_KEY_V2=

# A dedicated AES-256-GCM key for the off-site export, escrowed off-box.
# Generate with: php artisan key:generate --show — never reuse APP_KEY or DB_CRYPT_KEY.
FLEET_BACKUP_KEY=
FLEET_BACKUP_DISK=offsite
FLEET_BACKUP_PREFIX=backups
FLEET_BACKUP_STALE_DAYS=35

# Production: a bucket at a different provider/region, with credentials that are not the documents
# bucket's. Fill these in and set FLEET_BACKUP_DISK=offsite_s3. See docs/operations/deployment.md.
FLEET_BACKUP_S3_KEY=
FLEET_BACKUP_S3_SECRET=
FLEET_BACKUP_S3_REGION=
FLEET_BACKUP_S3_BUCKET=
FLEET_BACKUP_S3_ENDPOINT=
FLEET_BACKUP_S3_PATH_STYLE=false
